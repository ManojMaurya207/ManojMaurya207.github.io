rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'manojkumarmaurya9372@gmail.com';
    }

    function imageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function certificateFileUpload() {
      return request.resource != null
        && request.resource.size <= 15728640
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|webp)'));
    }

    // These assets are intentionally public. Only the verified portfolio
    // owner can replace or remove them.
    match /profile/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin()
        && (imageUpload(8388608)
          || (request.resource.size <= 15728640
            && request.resource.contentType == 'application/pdf'));
      allow delete: if isPortfolioAdmin();
    }

    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin() && imageUpload(8388608);
      allow delete: if isPortfolioAdmin();
    }

    match /certificates/{entryId}/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin() && certificateFileUpload();
      allow delete: if isPortfolioAdmin();
    }

    match /blogs/{blogId}/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin() && imageUpload(5242880);
      allow delete: if isPortfolioAdmin();
    }
  }
}
