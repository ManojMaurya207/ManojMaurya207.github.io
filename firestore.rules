rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio collections contain intentionally public professional content.
    // Blog documents additionally support private drafts managed from /admin.
    function published() { return resource.data.isPublished == true; }
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'manojkumarmaurya9372@gmail.com';
    }
    function validBlogTags(tags) {
      return tags is list && tags.size() <= 8
        && (tags.size() < 1 || tags[0] is string)
        && (tags.size() < 2 || tags[1] is string)
        && (tags.size() < 3 || tags[2] is string)
        && (tags.size() < 4 || tags[3] is string)
        && (tags.size() < 5 || tags[4] is string)
        && (tags.size() < 6 || tags[5] is string)
        && (tags.size() < 7 || tags[6] is string)
        && (tags.size() < 8 || tags[7] is string);
    }
    function validBlog(blog) {
      return blog.keys().hasAll([
          'title', 'slug', 'category', 'excerpt', 'content', 'coverImage',
          'tags', 'readingTime', 'isPublished', 'order', 'createdAt', 'updatedAt'
        ])
        && blog.keys().hasOnly([
          'title', 'slug', 'category', 'excerpt', 'content', 'coverImage',
          'tags', 'readingTime', 'isPublished', 'order', 'createdAt', 'updatedAt'
        ])
        && blog.title is string && blog.title.size() > 0 && blog.title.size() <= 120
        && blog.slug is string && blog.slug.size() > 0 && blog.slug.size() <= 140
        && blog.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && blog.category is string && blog.category.size() > 0 && blog.category.size() <= 40
        && blog.excerpt is string && blog.excerpt.size() <= 320
        && blog.content is string && blog.content.size() <= 50000
        && blog.coverImage is string && blog.coverImage.size() <= 2048
        && (blog.coverImage == '' || blog.coverImage.matches('^https://.*'))
        && validBlogTags(blog.tags)
        && blog.readingTime is int && blog.readingTime >= 1 && blog.readingTime <= 120
        && blog.isPublished is bool
        && blog.order is int && blog.order > 0 && blog.order <= 9007199254740991
        && blog.createdAt is timestamp
        && blog.updatedAt is timestamp && blog.updatedAt == request.time;
    }

    match /portfolio/{id} {
      allow get: if published();
      allow list: if false;
      allow write: if false;
    }
    match /settings/{id} {
      allow get: if published();
      allow list: if false;
      allow write: if false;
    }
    match /projects/{id} { allow read: if published(); allow write: if false; }
    match /experience/{id} { allow read: if published(); allow write: if false; }
    match /education/{id} { allow read: if published(); allow write: if false; }
    match /skills/{id} { allow read: if published(); allow write: if false; }
    match /skillCategories/{id} { allow read: if published(); allow write: if false; }
    match /achievements/{id} { allow read: if published(); allow write: if false; }
    match /certificates/{id} { allow read: if published(); allow write: if false; }
    match /workshops/{id} { allow read: if published(); allow write: if false; }
    match /socialLinks/{id} { allow read: if published(); allow write: if false; }

    match /blogs/{id} {
      allow get, list: if isPortfolioAdmin() || published();
      allow create: if isPortfolioAdmin()
        && validBlog(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isPortfolioAdmin()
        && validBlog(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isPortfolioAdmin();
    }
  }
}
